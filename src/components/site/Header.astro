---
import { business } from '../../config/business.ts';

const nav = [
  { label: 'Home', href: '/' },
  { label: 'About', href: '/about-us/' },
  { label: 'Services', href: '/our-services/' },
  { label: 'Contact', href: '/contact-us/' },
];
---
<header class="site-header">
  <div class="container hdr-inner">
    <a href="/" class="brand" aria-label={business.name}>
      <img src="/assets/wp-content/uploads/2021/12/logo-h-color-stretton.png" alt={business.name} width="1130" height="335" />
    </a>

    <nav class="nav" aria-label="Primary">
      {nav.map((n) => <a href={n.href}>{n.label}</a>)}
    </nav>

    <div class="hdr-cta">
      <a class="phone" href={`tel:${business.phoneTel}`}>
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        <span>{business.phoneDisplay}</span>
      </a>
      <a class="btn btn-primary" href={business.quoteUrl}>Get a quote</a>
      <button class="nav-toggle" aria-label="Menu" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <nav class="mobile-nav" aria-label="Mobile">
    {nav.map((n) => <a href={n.href}>{n.label}</a>)}
    <a class="btn btn-primary btn-lg" href={business.quoteUrl}>Get a quote</a>
    <a class="mobile-phone" href={`tel:${business.phoneTel}`}>Call {business.phoneDisplay}</a>
  </nav>
</header>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 50;
    background: color-mix(in srgb, var(--surface, #ffffff) 95%, transparent);
    backdrop-filter: saturate(180%) blur(12px);
    border-bottom: 1px solid var(--border, #e3e7f0);
    box-shadow: 0 1px 3px rgba(16, 24, 40, 0.05);
  }
  .container {
    width: 100%;
    max-width: 1160px;
    margin-inline: auto;
    padding-inline: 1.25rem;
    box-sizing: border-box;
  }
  .hdr-inner { display: flex; align-items: center; gap: 1.5rem; height: 74px; }
  .brand { display: flex; align-items: center; text-decoration: none; }
  .brand img { height: 40px; width: auto; max-height: 40px; }
  .nav { display: flex; gap: 0.35rem; margin-left: auto; }
  .nav a {
    font-family: var(--font-head, "Space Grotesk", "Inter", sans-serif);
    font-weight: 500;
    color: var(--fg, #131a2b);
    padding: 0.5rem 0.85rem;
    border-radius: 8px;
    font-size: var(--step-0, 1rem);
    text-decoration: none;
    transition: color 0.15s ease, background 0.15s ease;
  }
  .nav a:hover {
    text-decoration: none;
    color: var(--brand-strong, #1d4ed8);
    background: var(--surface-2, #f5f7fb);
  }
  .hdr-cta { display: flex; align-items: center; gap: 0.9rem; }
  .phone {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-head, "Space Grotesk", "Inter", sans-serif);
    font-weight: 600;
    color: var(--ink, #0b1220);
    text-decoration: none;
  }
  .phone:hover { text-decoration: none; color: var(--brand-strong, #1d4ed8); }
  .phone svg { color: var(--brand, #2563eb); }
  
  .btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem;
    font-family: var(--font-head, "Space Grotesk", "Inter", sans-serif);
    font-weight: 600; font-size: 1rem;
    padding: 0.75rem 1.4rem; border-radius: 999px; border: 1px solid transparent;
    cursor: pointer; transition: transform .15s ease, box-shadow .2s ease, background .2s ease;
    text-decoration: none; line-height: 1; white-space: nowrap;
  }
  .btn:hover { text-decoration: none; transform: translateY(-1px); }
  .btn-primary {
    background: var(--brand, #2563eb);
    color: #ffffff;
    box-shadow: 0 8px 22px -8px rgba(37, 99, 235, 0.7);
  }
  .btn-primary:hover { background: var(--brand-strong, #1d4ed8); }
  .btn-lg { padding: 0.9rem 1.7rem; font-size: 1.05rem; }

  .nav-toggle { display: none; flex-direction: column; gap: 5px; background: none; border: 0; padding: 6px; cursor: pointer; }
  .nav-toggle span { width: 24px; height: 2px; background: var(--ink, #0b1220); border-radius: 2px; transition: .2s; }
  .mobile-nav { display: none; }

  @media (max-width: 900px) {
    .nav { display: none; }
    .phone span { display: none; }
    .nav-toggle { display: flex; }
    .mobile-nav {
      display: grid; gap: 0.35rem; padding: 1rem 1.25rem 1.5rem;
      border-bottom: 1px solid var(--border, #e3e7f0); background: var(--surface, #ffffff);
      max-height: 0; overflow: hidden; padding-block: 0; transition: max-height .28s ease, padding .28s ease;
    }
    .mobile-nav.open { max-height: 420px; padding-block: 1rem 1.5rem; }
    .mobile-nav a {
      font-family: var(--font-head, "Space Grotesk", "Inter", sans-serif);
      font-weight: 500; padding: 0.7rem 0.5rem; color: var(--fg, #131a2b); border-radius: 8px;
      text-decoration: none;
    }
    .mobile-nav a:hover { background: var(--surface-2, #f5f7fb); text-decoration: none; }
    .mobile-nav .btn { justify-content: center; margin-top: 0.5rem; }
    .mobile-phone { color: var(--brand-strong, #1d4ed8) !important; text-align: center; text-decoration: none; font-weight: 600; }
  }
</style>

<script is:inline>
  (function () {
    const btn = document.querySelector('.nav-toggle');
    const menu = document.querySelector('.mobile-nav');
    if (!btn || !menu) return;
    btn.addEventListener('click', function () {
      const open = menu.classList.toggle('open');
      btn.setAttribute('aria-expanded', String(open));
    });
  })();
</script>
