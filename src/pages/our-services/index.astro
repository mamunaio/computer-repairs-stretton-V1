---
import Site from '../../layouts/Site.astro';
import { business } from '../../config/business.ts';
import services from '../../data/services-full.json';
import pageData from '../../data/pages/our-services.json';

const head = pageData.head;
// Source intro line, reused verbatim from the original Services page.
const intro =
  "We don't just offer computer repairs, we offer the following services to help you with any of your IT or computer needs throughout the Stretton area.";

const icons: Record<string, string> = {
  apple: '<path d="M12 20.5c-2 0-3-1.5-4.5-4C6 14 5.5 11 7 9c1-1.3 2.5-1.4 3.5-1 .8.3 1.2.3 2 0 1-.4 2.5-.3 3.5 1"/><path d="M12 6c0-1.5 1-3 2.5-3.5"/>',
  laptop: '<rect x="3" y="4" width="18" height="12" rx="2"/><path d="M2 20h20"/>',
  shield: '<path d="M12 3l7 3v5c0 4.5-3 8-7 10-4-2-7-5.5-7-10V6z"/><path d="M9 12l2 2 4-4"/>',
  database: '<ellipse cx="12" cy="6" rx="8" ry="3"/><path d="M4 6v12c0 1.7 3.6 3 8 3s8-1.3 8-3V6"/><path d="M4 12c0 1.7 3.6 3 8 3s8-1.3 8-3"/>',
  wifi: '<path d="M5 12.5a10 10 0 0 1 14 0"/><path d="M8.5 16a5 5 0 0 1 7 0"/><circle cx="12" cy="19.5" r="1"/><path d="M2 9a15 15 0 0 1 20 0"/>',
  mail: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/>',
  globe: '<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.5 2.5 15 0 18M12 3c-2.5 2.5-2.5 15 0 18"/>',
  book: '<path d="M4 5a2 2 0 0 1 2-2h13v16H6a2 2 0 0 0-2 2z"/><path d="M4 19a2 2 0 0 1 2-2h13"/>',
  smartphone: '<rect x="7" y="2" width="10" height="20" rx="2"/><path d="M11 18h2"/>',
  wrench: '<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>',
  settings: '<circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/>',
  file: '<path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"/><path d="M14 3v6h6"/>',
  spark: '<path d="M12 3l1.9 5.6L19.5 10l-4.6 3.4L16.5 19 12 15.7 7.5 19l1.6-5.6L4.5 10l5.6-1.4z"/>',
  camera: '<path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/>',
  home: '<path d="M3 10.5L12 3l9 7.5"/><path d="M5 9v11a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V9"/>',
  tv: '<rect x="2" y="7" width="20" height="13" rx="2"/><path d="M8 3l4 4 4-4"/>',
  server: '<rect x="3" y="4" width="18" height="7" rx="2"/><rect x="3" y="13" width="18" height="7" rx="2"/><path d="M7 7.5h.01M7 16.5h.01"/>',
};
const Icon = (name: string) =>
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">${icons[name] || icons.spark}</svg>`;
---
<Site
  title={head.title}
  description={head.metaDescription}
  canonical={head.canonical}
  ogImage={head.og?.['og:image']}
>
  <section class="page-hero">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a> / <span>Our Services</span></nav>
      <h1>Our Services</h1>
      <p class="page-sub">{intro}</p>
    </div>
  </section>

  <div class="container section">
    <div class="svc-grid">
      {services.map((s: any) => {
        const inner = (
          <>
            <span class="svc-ic" style={`--c:${s.color}`} set:html={Icon(s.icon)}></span>
            <h3>{s.name}</h3>
            <p>{s.blurb}</p>
            {s.href && <span class="svc-more">Learn more →</span>}
          </>
        );
        return s.href
          ? <a class="svc-card is-link" href={s.href}>{inner}</a>
          : <div class="svc-card">{inner}</div>;
      })}
    </div>

    <div class="svc-cta">
      <a class="btn btn-primary btn-lg" href={business.quoteUrl}>Get a quote</a>
      <a class="btn btn-outline btn-lg" href={`tel:${business.phoneTel}`}>Call {business.phoneDisplay}</a>
    </div>
  </div>

  <section class="brands-expertise">
    <div class="be-wrap">
      <span class="be-eyebrow">Our Brands Of Expertise</span>
      <h2>Our services run deep and are backed by over ten years of experience.</h2>
      <div class="be-grid">
        <div class="be-card"><img src="/brands/logo-asus.png" alt="Asus repairs" loading="lazy" /></div>
        <div class="be-card"><img src="/brands/logo-dell.png" alt="Dell repairs" loading="lazy" /></div>
        <div class="be-card"><img src="/brands/logo-lenovo.png" alt="Lenovo repairs" loading="lazy" /></div>
        <div class="be-card"><img src="/brands/logo-ibm.png" alt="IBM repairs" loading="lazy" /></div>
        <div class="be-card"><img src="/brands/logo-toshiba.png" alt="Toshiba repairs" loading="lazy" /></div>
        <div class="be-card"><img src="/brands/logo-hp.png" alt="HP repairs" loading="lazy" /></div>
        <div class="be-card"><img src="/brands/logo-fujitsu.png" alt="Fujitsu repairs" loading="lazy" /></div>
        <div class="be-card"><img src="/brands/logo-acer.png" alt="Acer repairs" loading="lazy" /></div>
        <div class="be-card"><img src="/brands/logo-sony.png" alt="Sony repairs" loading="lazy" /></div>
        <div class="be-card"><img src="/brands/logo-compaq.png" alt="Compaq repairs" loading="lazy" /></div>
        <div class="be-card"><img src="/brands/logo-apple.png" alt="Apple repairs" loading="lazy" /></div>
      </div>
    </div>
  </section>
</Site>

<style>
  .brands-expertise { background: #fff; padding: 64px 0; text-align: center; }
  .brands-expertise .be-wrap { max-width: 1120px; margin: 0 auto; padding: 0 24px; }
  .brands-expertise .be-eyebrow { display: block; color: #2563eb; font-weight: 700; letter-spacing: .14em; font-size: 12px; text-transform: uppercase; margin-bottom: 10px; }
  .brands-expertise h2 { font-size: 30px; line-height: 1.25; margin: 0 auto 36px; max-width: 760px; color: #0a1020; }
  .brands-expertise .be-grid { display: grid; grid-template-columns: repeat(6, 1fr); gap: 16px; }
  .brands-expertise .be-card { background: #0f1729; border-radius: 14px; min-height: 92px; display: flex; align-items: center; justify-content: center; padding: 18px; }
  .brands-expertise .be-card img { max-height: 40px; max-width: 80%; width: auto; }
  @media (max-width: 900px) { .brands-expertise .be-grid { grid-template-columns: repeat(4, 1fr); } }
  @media (max-width: 560px) { .brands-expertise .be-grid { grid-template-columns: repeat(3, 1fr); } }
  .svc-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }
  .svc-card {
    display: flex; flex-direction: column; align-items: flex-start;
    background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius);
    padding: 1.5rem; color: inherit;
  }
  .svc-card.is-link { transition: transform .16s ease, box-shadow .2s ease, border-color .2s ease; }
  .svc-card.is-link:hover { text-decoration: none; transform: translateY(-3px); box-shadow: var(--shadow-md); border-color: color-mix(in srgb, var(--c) 45%, var(--border)); }
  .svc-ic { display: grid; place-items: center; width: 46px; height: 46px; border-radius: 12px; margin-bottom: 1rem;
    color: var(--c); background: color-mix(in srgb, var(--c) 13%, transparent); }
  .svc-ic svg { width: 25px; height: 25px; }
  .svc-card h3 { font-size: var(--step-1); margin-bottom: 0.4rem; }
  .svc-card p { color: var(--fg-soft); font-size: var(--step--1); margin: 0 0 0.9rem; }
  .svc-more { margin-top: auto; font-family: var(--font-head); font-weight: 600; font-size: var(--step--1); color: var(--c); }
  .svc-cta { display: flex; gap: 1rem; flex-wrap: wrap; margin-top: var(--sp-5); }
  @media (max-width: 860px) { .svc-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { .svc-grid { grid-template-columns: 1fr; } }
</style>
