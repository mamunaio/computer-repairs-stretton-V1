---
import ActiveDeterrenceShowcase from '../../../components/cctv-service-stretton/ActiveDeterrenceShowcase.astro';
import Faq from '../../../components/cctv-service-stretton/Faq.astro';
import FeaturedAwards from '../../../components/cctv-service-stretton/FeaturedAwards.astro';
import Footer from '../../../components/cctv-service-stretton/Footer.astro';
import Header from '../../../components/cctv-service-stretton/Header.astro';
import Hero from '../../../components/cctv-service-stretton/Hero.astro';
import Inclusions from '../../../components/cctv-service-stretton/Inclusions.astro';
import InstallerProfile from '../../../components/cctv-service-stretton/InstallerProfile.astro';
import LocalCaseStudy from '../../../components/cctv-service-stretton/LocalCaseStudy.astro';
import MasterCablerSection from '../../../components/cctv-service-stretton/MasterCablerSection.astro';
import MobileAppViewer from '../../../components/cctv-service-stretton/MobileAppViewer.astro';
import PricingPackages from '../../../components/cctv-service-stretton/PricingPackages.astro';
import ProcessSteps from '../../../components/cctv-service-stretton/ProcessSteps.astro';
import QuoteForm from '../../../components/cctv-service-stretton/QuoteForm.astro';
import Reviews from '../../../components/cctv-service-stretton/Reviews.astro';
import ServicesGrid from '../../../components/cctv-service-stretton/ServicesGrid.astro';
import StrettonServiceArea from '../../../components/cctv-service-stretton/StrettonServiceArea.astro';
import SuburbGrid from '../../../components/cctv-service-stretton/SuburbGrid.astro';
import SystemComparison from '../../../components/cctv-service-stretton/SystemComparison.astro';
import TrustBadges from '../../../components/cctv-service-stretton/TrustBadges.astro';
import WomBadges from '../../../components/cctv-service-stretton/WomBadges.astro';
import CctvLayout from '../../../layouts/CctvLayout.astro';
import { fetchContent } from '../../../lib/content-client';

const content = await fetchContent('stretton');
---

<CctvLayout title={content.seo.title} description={content.seo.description}>
  <Header />
  <Hero 
    heading={content.hero.heading}
    description={content.hero.description}
  />
  <TrustBadges />
  <MasterCablerSection />
  <FeaturedAwards />
  <ServicesGrid />
  <ActiveDeterrenceShowcase />
  <MobileAppViewer />
  <Inclusions />
  <SystemComparison />
  <PricingPackages />
  <ProcessSteps />
  <LocalCaseStudy />
  <InstallerProfile />
  <Reviews />
  <SuburbGrid />
  <Faq />
  <QuoteForm />
  <WomBadges />
  <StrettonServiceArea />
  <Footer />
</CctvLayout>
