---
import Site from '../../layouts/Site.astro';
import { business } from '../../config/business.ts';
import { about } from '../../data/about.ts';
import pageData from '../../data/pages/about-us.json';

const head = pageData.head;
const brandName = (b: string) => b === 'ibm' ? 'IBM' : b === 'hp' ? 'HP' : b[0].toUpperCase() + b.slice(1);
---
<Site
  title={head.title}
  description={head.metaDescription}
  canonical={head.canonical}
  ogImage="/assets/wp-content/uploads/2021/12/logo-h-color-stretton.png"
>
  <section class="page-hero">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a> / <span>About Us</span></nav>
      <h1>About Us</h1>
      <p class="page-sub">Family-owned, Microsoft Certified, and part of the Stretton community for over 20 years.</p>
    </div>
  </section>

  
  <section class="section">
    <div class="container welcome-grid">
      <div class="prose">
        <span class="eyebrow">Who we are</span>
        <h2>{about.welcomeHeading}</h2>
        {about.welcome.map((p) => <p>{p}</p>)}
        <a class="btn btn-primary" href={business.quoteUrl}>Get a free quote</a>
      </div>
      <aside class="channel9">
        <img src="/assets/wp-content/uploads/2024/06/01A_NINE_MASTER_LOGO_STACKED-Colour-Positive-300x300.webp" alt="Channel 9" width="150" height="150" />
        <h3>See us on Channel 9</h3>
        <p>We were interviewed by Channel 9 about slow internet speeds.</p>
        <img class="mcp" src="/assets/wp-content/uploads/2024/06/microsoft_logo.png" alt="Microsoft Certified Professional" />
        <p class="mcp-note">Microsoft Certified Professional (MCP)</p>
      </aside>
    </div>
  </section>

  
  <section class="section band-tint">
    <div class="container narrow prose">
      <span class="eyebrow">Why reviews matter</span>
      <h2>{about.reviewsHeading}</h2>
      {about.reviews.map((p) => <p>{p}</p>)}
    </div>
  </section>

  
  <section class="section">
    <div class="container diag-grid">
      <img class="diag-img" src="/assets/wp-content/uploads/2024/06/IMG_0801-1024x726.png" alt="Our technician at work" width="1024" height="726" />
      <div class="prose">
        <span class="eyebrow">Honest pricing</span>
        <h2>{about.diagnosticsHeading}</h2>
        {about.diagnostics.map((p) => <p>{p}</p>)}
      </div>
    </div>
  </section>

  
  <section class="section band-brand">
    <div class="container narrow prose picasso">
      <h2>{about.picassoHeading}</h2>
      {about.picasso.map((p) => <p>{p}</p>)}
    </div>
  </section>

  
  <section class="section">
    <div class="container text-center">
      <span class="eyebrow">Our brands of expertise</span>
      <h2>{about.brandsSub}</h2>
      <div class="brand-logos">
        {about.brands.map((b) => (
          <div class="brand-logo"><img src={`/assets/wp-content/uploads/2021/08/logo-${b}.png`} alt={brandName(b)} /></div>
        ))}
      </div>
    </div>
  </section>

  
  <section class="section band-tint">
    <div class="container">
      <div class="section-head text-center mx-auto">
        <span class="eyebrow">Meet the team</span>
        <h2>The people behind your repairs</h2>
      </div>
      <div class="team-grid">
        {about.team.map((m) => (
          <article class="team-card">
            <img src={m.photo} alt={m.name} />
            <div class="team-body">
              <h3>{m.name}</h3>
              <span class="team-role">{m.role}</span>
              <p>{m.bio}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  
  <section class="cta-band">
    <div class="container cta-inner">
      <div>
        <h2>Trusted by hundreds of locals</h2>
        <img class="cta-badges" src="/assets/wp-content/uploads/2024/06/badges-new-1024x136.png" alt="Word of Mouth service awards, 10 years running" width="1024" height="136" />
      </div>
      <div class="cta-actions">
        <a class="btn btn-primary btn-lg" href={business.quoteUrl}>Get a free quote</a>
        <a class="btn btn-ghost btn-lg" href={`tel:${business.phoneTel}`}>Call {business.phoneDisplay}</a>
      </div>
    </div>
  </section>
</Site>

<style>
  .band-tint { background: var(--surface-2); }
  .band-brand { background: linear-gradient(160deg, var(--brand-tint), var(--surface)); }
  .narrow { max-width: 780px; }
  .welcome-grid { display: grid; grid-template-columns: 1.6fr 1fr; gap: 3rem; align-items: start; }
  .prose .eyebrow { display: block; margin-bottom: 0.6rem; }
  .prose h2 { margin-top: 0.2rem; }
  .prose .btn { margin-top: 0.5rem; }

  .channel9 { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: 2rem; text-align: center; box-shadow: var(--shadow-sm); position: sticky; top: 96px; }
  .channel9 img { margin: 0 auto; }
  .channel9 h3 { margin: 1rem 0 0.4rem; }
  .channel9 p { color: var(--fg-soft); font-size: var(--step--1); }
  .channel9 .mcp { width: 150px; margin: 1.4rem auto 0.5rem; }
  .mcp-note { font-weight: 600; color: var(--brand-strong) !important; }

  .diag-grid { display: grid; grid-template-columns: 0.9fr 1.3fr; gap: 3rem; align-items: center; }
  .diag-img { border-radius: var(--radius-lg); box-shadow: var(--shadow-md); }
  .picasso p:nth-last-child(2) { font-family: var(--font-head); font-size: var(--step-1); color: var(--brand-strong); }

  .brand-logos { display: grid; grid-template-columns: repeat(6, 1fr); gap: 1rem; margin-top: var(--sp-5); }
  .brand-logo { background: var(--ink); border: 1px solid var(--ink); border-radius: var(--radius); padding: 1.1rem; display: grid; place-items: center; min-height: 90px; transition: transform .16s ease, box-shadow .2s ease; }
  .brand-logo:hover { transform: translateY(-3px); box-shadow: var(--shadow-md); }
  .brand-logo img { max-height: 42px; width: auto; object-fit: contain; }

  .team-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
  .team-card { display: grid; grid-template-columns: 150px 1fr; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-lg); overflow: hidden; }
  .team-card > img { width: 150px; height: 100%; object-fit: cover; }
  .team-body { padding: 1.5rem; }
  .team-role { display: inline-block; font-family: var(--font-head); font-weight: 600; font-size: var(--step--1); color: var(--brand-strong); background: var(--brand-tint); padding: 0.2rem 0.7rem; border-radius: 999px; margin: 0.3rem 0 0.8rem; }
  .team-body p { color: var(--fg-soft); font-size: var(--step--1); }

  .cta-band { background: linear-gradient(120deg, var(--brand-strong), var(--brand)); color: #fff; }
  .cta-inner { display: flex; align-items: center; justify-content: space-between; gap: 2rem; padding-block: var(--sp-6); flex-wrap: wrap; }
  .cta-band h2 { color: #fff; margin-bottom: 1rem; }
  .cta-badges { max-width: 460px; width: 100%; background: rgba(255,255,255,.9); border-radius: 10px; padding: 8px; }
  .cta-actions { display: flex; gap: 0.9rem; flex-wrap: wrap; }

  @media (max-width: 900px) {
    .welcome-grid, .diag-grid { grid-template-columns: 1fr; gap: 2rem; }
    .channel9 { position: static; max-width: 360px; }
    .diag-img { order: 2; }
    .brand-logos { grid-template-columns: repeat(4, 1fr); }
    .team-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) {
    .brand-logos { grid-template-columns: repeat(3, 1fr); }
    .team-card { grid-template-columns: 1fr; }
    .team-card > img { width: 100%; height: 220px; }
  }
</style>
